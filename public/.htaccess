<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # http → 同じパスの https へ 301（SEC-001）。サブフォルダの .htaccess は親（ドメイン直下）の
    # RewriteRule を引き継がないため、ここで転送する。前段のプロキシが X-Forwarded-Proto で https を
    # 伝える構成でも転送が繰り返されないようにし、ローカル（localhost）では転送しない
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
    Header always set X-Content-Type-Options "nosniff"

    # Referrer-Policy（SEC-008）。お客さんの公開 API（…/api/public/tables/{token}/…）は URL のトークンを
    # 漏らさないため no-referrer（ResolveTableToken と同じ値）、それ以外は same-origin。
    # 書き換え（index.php）の後でも元の URL で判定できるよう THE_REQUEST（要求行）を見る。
    # サブフォルダ名（/regi）に依存しないよう、パスの途中の /api/public/tables/ で判定する
    Header always set Referrer-Policy "no-referrer" "expr=%{THE_REQUEST} =~ m#^[A-Z]+ [^ ?]*/api/public/tables/#"
    Header always set Referrer-Policy "same-origin" "expr=%{THE_REQUEST} !~ m#^[A-Z]+ [^ ?]*/api/public/tables/#"

    # HSTS（SEC-001）。http の応答に付いてもブラウザは無視するため条件は付けない。
    # 同じドメインの他のフォルダ（/hiroseya など）にも効く。includeSubDomains・preload は付けない
    Header always set Strict-Transport-Security "max-age=31536000"

    # フレーム埋め込みの禁止（SEC-004）。レシート・QR の印刷は window.print() で iframe を使わない
    Header always set X-Frame-Options "SAMEORIGIN"
    # 使わない機能を止める。画面の消灯防止（レジ・厨房の Screen Wake Lock）だけ自サイトに許す
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), screen-wake-lock=(self)"
    # CSP（SEC-004）。まず Report-Only で入れ、本番の開発者ツールで違反が出ないことを確かめてから
    # Content-Security-Policy に切り替える（docs/11 §1.4）。img-src の data: はテーブルの QR（SVG の data: URI）用。
    # 外部のフォント・CDN を使い始めるときはここに追加すること
    Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>

# Service Worker は常に最新を取りに行かせる
<Files "sw.js">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache"
    </IfModule>
</Files>

# PWA のマニフェストを正しい MIME 型で返す（nosniff のため必要）
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

# API の JSON・画面の HTML・JS・CSS を gzip で圧縮して返す
# （レジの初期データ 59KB → 約 5KB、お客さんのメニュー 34KB → 約 3KB。回線が細い店内の Wi-Fi・スマホ回線で効く）
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/json text/html text/css text/javascript application/javascript application/manifest+json image/svg+xml
</IfModule>

# ハッシュ付きのビルド成果物は長く保持させる
<IfModule mod_headers.c>
    <FilesMatch "^.*-[A-Za-z0-9_-]{8}\.(js|css|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
